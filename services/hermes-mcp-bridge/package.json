  "mcpName": "org.noren/hermes-agent",
  "description": "MCP server exposing Hermes agent runs through the Hermes API server",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "noren-hermes-mcp": "dist/server.js"
  },
  "keywords": ["mcp", "hermes", "agent", "noren"],
