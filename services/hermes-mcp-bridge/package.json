  "repository": {
    "type": "git",
    "url": "https://github.com/norenagent/noren"
  },
  "homepage": "https://usenoren.xyz",
  "engines": {
    "node": ">=22"
  },
  "files": ["dist", "README.md", "server.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
