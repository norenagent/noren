# Noren runs on Robinhood Chain (chain id 4663, testnet 46630). Payments settle in USDG.
# Copy to .env and fill in. Keys and tokens stay off-repo.

# Chain
NOREN_CHAIN_ID=4663
NOREN_RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_NOREN_CHAIN_ID=4663
NEXT_PUBLIC_NOREN_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Token (Noren Agents, 18 decimals, 1,000,000,000 supply)
NEXT_PUBLIC_NOREN_TOKEN_ADDRESS=0xd7ccebb9a014a713879093979c7016db72486e62
NEXT_PUBLIC_NOREN_TOKEN_NAME=Noren Agents
NEXT_PUBLIC_NOREN_TOKEN_SYMBOL=NOREN
NEXT_PUBLIC_NOREN_TOKEN_DECIMALS=18

# Brand / site
NEXT_PUBLIC_SITE_URL=https://usenoren.xyz
NEXT_PUBLIC_DOCS_URL=https://docs.usenoren.xyz
NEXT_PUBLIC_NOREN_X_HANDLE=@NorenAgent

# Local daemon HTTP gateway (server-side only). The console proxies all daemon
# traffic through /api/noren/* so the operator bearer token never reaches the
# browser. By default the token is read from ${NOREN_HOME}/peers/operator.token.
NOREN_DAEMON_URL=http://127.0.0.1:8421
NOREN_HTTP_PORT=8421
NOREN_HTTP_BIND_ADDR=127.0.0.1
# NOREN_HOME=$HOME/.noren
# NOREN_OPERATOR_TOKEN_PATH=$HOME/.noren/peers/operator.token
# NOREN_OPERATOR_TOKEN=

# x402 payments in USDG on Robinhood Chain (EIP-3009 / approve + transferFrom)
# NOREN_X402_ENABLED=false
# NOREN_X402_SIGNER_BINARY=               # path to noren-x402-signer-evm
# NOREN_X402_EVM_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# NOREN_X402_EVM_CHAIN_ID=4663
# NOREN_X402_EVM_KEY_HEX=               # payer key (64 hex chars), never commit; or NOREN_X402_EVM_KEY=<file>
# NOREN_X402_USDG_RECIPIENT=             # 0x... address that receives payments
# NOREN_X402_EVM_FACILITATOR_URL=

# Issuer identity (secp256k1, EVM address)
# NOREN_EVM_ISSUER_KEY=                  # path to key file, created 0600 on first run

# Sandbox workspaces and the built-in agent
# NOREN_WORKSPACE_RUNTIME=
# NOREN_AGENT_PROVIDER=
# NOREN_AGENT_API_KEY=
# NOREN_AGENT_DAILY_CALLS=

# Indexer
INDEXER_BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# Backing services (docker compose up -d)
DATABASE_URL=postgres://noren:change-me@localhost:5432/noren
REDIS_URL=redis://localhost:6379

# Optional service credentials (off-repo)
# IONET_API_KEY=
# AKASH_WALLET=
# HERMES_API_BASE_URL=
# HERMES_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_ALLOWED_USER_IDS=               # comma-separated numeric user ids; empty = deny-all
# TELEGRAM_RATE_LIMIT_PER_MIN=5            # per-user command bucket
# SESSION_SECRET=                       # 32+ chars, hex/base64 preferred
# OPERATOR_BEARER_TOKEN=                # compute-broker; >=16 chars; required for /leases/* side-effect endpoints
# BOND_CANCEL_MAX_EXPIRY_SECS=300       # compute-broker /bonds/cancel signed-request expiry cap
# PROOFGEN_WITNESS_WRAP_KEY=            # proof-gen; 32-byte base64; required, wraps witness AES key outside Redis
# PROOFGEN_RATE_LIMIT_BURST=10
# PROOFGEN_RATE_LIMIT_WINDOW_MS=60000

# AceData generative provider (norend). Off by default; the API key is
# a Bearer billing credential — keep it off-repo.
# NOREN_ACEDATA_ENABLED=true
# NOREN_ACEDATA_API_KEY=                 # from platform.acedata.cloud console
# NOREN_ACEDATA_BASE_URL=https://api.acedata.cloud
# NOREN_ACEDATA_ALLOW=acedata.search     # comma-separated tool allowlist; empty = all
# NOREN_ACEDATA_IMAGE_MODEL=flux-pro
# NOREN_ACEDATA_MUSIC_MODEL=chirp-v4

# Spend-grant escrow attestor (norend). Off by default. When enabled the
# daemon judges each escrow call against its own audit chain and signs a
# secp256k1 eip-712 quality attestation the SpendGrantEscrow verifies before
# releasing the held payment (refunds the grant on a fail verdict). Settles in
# USDG on Robinhood Chain. The attestor key and the gas-payer submitter key are
# secrets — keep them off-repo.
# NOREN_SPENDGRANT_ENABLED=false
# NOREN_SPENDGRANT_ATTESTOR_KEY=         # secp256k1 attestor key path; its address is the escrow's `attestor` role
# NOREN_SPENDGRANT_ESCROW=               # deployed SpendGrantEscrow address (0x…)
# NOREN_SPENDGRANT_CHAIN=4663            # EVM chain id (4663 = Robinhood Chain mainnet, 46630 = testnet)
# NOREN_SPENDGRANT_RPC=                  # chain JSON-RPC URL; set to enable the in-process release/refund submitter (else emit-only)
# NOREN_SPENDGRANT_SUBMITTER_KEY=        # funded gas-payer secret (0x… hex); pairs with _RPC to submit release/refund txs
